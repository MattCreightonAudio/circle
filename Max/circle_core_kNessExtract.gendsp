            {
                "box": {
                    "code": "ellipseStride=5;\r\noffset_freq=0;\r\noffset_A=1;\r\ntimeIndex = in1;\r\n\r\n//find total energy\r\nEtotal = 0;  \r\nfor (i = 0; i<numEllipses; i+=1)\r\n{\r\n    Etotal += peek(buf_ellipses, timeIndex, i*ellipseStride+offset_A);\r\n}\r\nout1 = Etotal;\r\n\r\n//reciprocate for efficiency\r\nEtotal_recip = 1 / Etotal;\r\n\r\n// find group energy values\r\nfor (k = 0; k<numEllipses; k+=1)\r\n{\r\n    a_k = peek(buf_ellipses, timeIndex, k*ellipseStride+offset_A);\r\n    \r\n    // we have to do the bounds checking here \r\n    // cant rely on the inbuilt bounds checking in max \r\n    // cause array bounds != true bounds\r\n    // cause max has no VLAs grr\r\n    a_kplus1 = \r\n      (k+1 == numEllipses) \r\n      ? 0 \r\n      : peek(buf_ellipses, timeIndex, (k+1)*ellipseStride+offset_A);\r\n      \r\n    diff_k = a_k - a_kplus1;\r\n    \r\n    // find and store G_k\r\n    // our index is zero based, hence the (k+1)\r\n    G_k = (k+1) * diff_k * Etotal_recip;\r\n    poke(Gk, G_k, k);\r\n}\r\n\r\n//clear Kness buffer\r\nfor (i = 0; i<60; i+=1) \r\n{  \r\n    poke(Kness, 0, i);\r\n}\r\n\r\n// How much energy is concentrated in the largest single peak?\r\nS_0 = peek(Gk, 0);\r\n\r\n\r\nfor (i=0; i<numEllipses; i+=1)\r\n{\r\n    for (j=i+1; j<numEllipses; j+=1)\r\n    {\r\n        // How much energy is concentrated in the peak-pair i,j?\r\n        pairEnergy = 0;\r\n\r\n        for (n=j; n<numEllipses; n +=1)\r\n        {\r\n            nChoose2 = (n+1) * n; // + not - because of indexing!!\r\n            G_n = peek(Gk, n);\r\n            pairEnergy += G_n/nChoose2;\r\n        }\r\n     \r\n        //IMPORTANT: we can only index into S_ij if we respect i<j\r\n        // we could fill out the other half of the matrix here \r\n        // since (lightly abusing notation) S[i][j] = S[j][i]\r\n        // but its inefficent and redundant\r\n        poke (S_ij, pairEnergy, i, j);\r\n        \r\n        //what freqRatio is associated with this pair?\r\n        omega_i = peek(buf_ellipses, timeIndex, i*ellipseStride+offset_freq);\r\n        omega_j = peek(buf_ellipses, timeIndex, j*ellipseStride+offset_freq);\r\n        omega_r = (omega_i > omega_j) ? omega_i/omega_j : omega_j/omega_i;\r\n        omega_r_semitones = 12 * log2(omega_r);\r\n        omega_r_semitones = round(omega_r_semitones);\r\n        \r\n        poke (Wr_ij, omega_r_semitones, i, j);\r\n        \r\n        // fill in Kness array with amounts at each semitine interval\r\n        // later we need to find the k-Ar, k-phi, blah BLAH\r\n        curr_Kness = peek(Kness, omega_r_semitones);\r\n        poke(Kness, curr_Kness+pairEnergy, omega_r_semitones);        \r\n    }\r\n}\r\n\r\n/*\r\nout1 = S_0;\r\nout2 = peek(S_ij, 0, 1);\r\nout3 = peek(S_ij, 0, 2);\r\nout4 = peek(S_ij, 0, 3);\r\nout5 = peek(S_ij, 1, 2);\r\nout6 = peek(S_ij, 1, 3);\r\nout7 = peek(S_ij, 2, 3);\r\n\r\nout8  = peek(Wr_ij, 0, 1);\r\nout9  = peek(Wr_ij, 0, 2);\r\nout10 = peek(Wr_ij, 0, 3);\r\nout11 = peek(Wr_ij, 1, 2);\r\nout12 = peek(Wr_ij, 1, 3);\r\nout13 = peek(Wr_ij, 2, 3);\r\n*/\r\n\r\nout1 = S_0;\r\nout2 = peek (Kness, 7);  // 3/2 ness\r\nout3 = peek (Kness, 12); // 2 ness\r\nout4 = peek (Kness, 19); // 3 ness\r\nout5 = peek (Kness, 24); // 4 ness ",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-10",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 5,
                    "outlettype": [ "", "", "", "", "" ],
                    "patching_rect": [ 184.0, 147.0, 619.0, 333.0 ]
                }
