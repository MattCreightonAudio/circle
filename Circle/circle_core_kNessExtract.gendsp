            {
                "box": {
                    "code": "require(\"circle_core_groupEnergy\");\r\n\r\ntimeIndex = in1;\r\nellipseStride = 5;\r\n    \r\n// initialise ellipses_local \r\nfor (i=0; i<numEllipses; i+=1) \r\n{\r\n    freq_i = peek(buf_ellipses, timeIndex, i*ellipseStride+0);\r\n    amp_i = peek(buf_ellipses, timeIndex, i*ellipseStride+1);\r\n\r\n    poke(ellipses_local, amp_i, i);\r\n}\r\n\r\n// figure out the group energies Gk and pair energies Sk\r\ncircle_groupEnergy(ellipses_local, numEllipses, G, S);\r\n\r\nfeatureWriteIdx = 1; // skip 0 - we'll use it for oneness later\r\nfor (i=1; i<numEllipses; i+=1) // iterate from 1 btw!\r\n{\r\n    freq_i = peek(buf_ellipses, timeIndex, i*ellipseStride+0); \r\n    \r\n    for (j=0; j<i; j+=1) // j is always less than i (thats why i starts at 1)\r\n    {\r\n        freq_j = peek(buf_ellipses, timeIndex, j*ellipseStride+0);\r\n        \r\n        hiFreq = 1;\r\n        loFreq = 1;\r\n        lo = 0;\r\n        hi = 0;\r\n        \r\n        if (freq_i > freq_j) \r\n        {\r\n            hiFreq = freq_i;\r\n            loFreq = freq_j;\r\n            lo = j;\r\n            hi = i;\r\n        } \r\n        else \r\n        {\r\n            loFreq = freq_i;\r\n            hiFreq = freq_j;\r\n            lo = i;\r\n            hi = j;\r\n        }\r\n        \r\n        if (loFreq < 0.001) loFreq = 0.001;\r\n        freqRatio = hiFreq/loFreq;\r\n        \r\n        // pair energy for this pair\r\n        // it depends only on i, not on j. funky but it works. \r\n        S_i = peek(S, i);\r\n                \r\n        // get vals for calculating features\r\n        A_lo     = peek(buf_ellipses, timeIndex, lo*ellipseStride+1);\r\n        A_hi     = peek(buf_ellipses, timeIndex, hi*ellipseStride+1);\r\n        shape_lo = peek(buf_ellipses, timeIndex, lo*ellipseStride+2);\r\n        shape_hi = peek(buf_ellipses, timeIndex, hi*ellipseStride+2);\r\n        phi_lo   = peek(buf_ellipses, timeIndex, lo*ellipseStride+3);\r\n        phi_hi   = peek(buf_ellipses, timeIndex, hi*ellipseStride+3);\r\n        tau_lo   = peek(buf_ellipses, timeIndex, lo*ellipseStride+4);\r\n        tau_hi   = peek(buf_ellipses, timeIndex, hi*ellipseStride+4);\r\n        \r\n        // calculate features\r\n        energy = S_i;\r\n        Asum = A_lo + A_hi;\r\n        if (Asum < 0.0001) Asum = 0.0001;\r\n        Abal = A_hi - A_lo / Asum;\r\n        sLo_x, sLo_y = poltocar(shape_lo, tau_lo);\r\n        sHi_x, sHi_y = poltocar(shape_hi, tau_hi);\r\n        phi = phasewrap(phi_lo * freqRatio - phi_hi); // lol imagine if this just works\r\n\r\n        \r\n        // blank out entries where the freqratio is very high or the energy very low\r\n        // since that means we didnt get a good lock\r\n        if (freqRatio > 17 || Asum < 0.05 || energy < 0.1)\r\n        {\r\n            energy = 0;\r\n            freqRatio = 0;\r\n            loFreq = 0;\r\n            Asum = 0;\r\n            Abal = 0;\r\n            sLo_x = 0;\r\n            sLo_y = 0;\r\n            sHi_x = 0;\r\n            sHi_y = 0;\r\n            phi = 0;\r\n        }\r\n        \r\n        // write into features buffer\r\n        poke(buf_features, energy,    timeIndex, featureWriteIdx*featureStride+0); // E\r\n        poke(buf_features, freqRatio, timeIndex, featureWriteIdx*featureStride+1); // Wr\r\n        poke(buf_features, loFreq,    timeIndex, featureWriteIdx*featureStride+2); // W0\r\n        poke(buf_features, Asum,      timeIndex, featureWriteIdx*featureStride+3); // Asum\r\n        poke(buf_features, Abal,      timeIndex, featureWriteIdx*featureStride+4); // Abal\r\n        poke(buf_features, sLo_x,     timeIndex, featureWriteIdx*featureStride+5); // sLo_x\r\n        poke(buf_features, sLo_y,     timeIndex, featureWriteIdx*featureStride+6); // sLo_y\r\n        poke(buf_features, sHi_x,     timeIndex, featureWriteIdx*featureStride+7); // sHi_x\r\n        poke(buf_features, sHi_y,     timeIndex, featureWriteIdx*featureStride+8); // sHi_y\r\n        poke(buf_features, phi,       timeIndex, featureWriteIdx*featureStride+9); // phi\r\n              \r\n        featureWriteIdx += 1;\r\n    } \r\n}\r\n\r\n// calculate oneness features \r\nE_1        = peek(G,0);\r\nW0_1       = peek(buf_ellipses, timeIndex, 0+0);\r\nA_1        = peek(buf_ellipses, timeIndex, 0+1);\r\nshape_1    = peek(buf_ellipses, timeIndex, 0+2);\r\ntau_1      = peek(buf_ellipses, timeIndex, 0+4);\r\ns1_x, s1_y = poltocar(shape_1, tau_1);\r\n\r\n// write oneness features \r\n// we hardcode the meaningless ones to suitable values\r\n// (this representation IS consistent with the model and stuff - \r\n// just with Abal = -1. So in a sense its a 2-Ellipse curve like any other)\r\npoke(buf_features, E_1,  timeIndex, 0+0); // E\r\npoke(buf_features, 1,    timeIndex, 0+1); // Wr\r\npoke(buf_features, W0_1, timeIndex, 0+2); // W0\r\npoke(buf_features, A_1,  timeIndex, 0+3); // Asum\r\npoke(buf_features, -1,   timeIndex, 0+4); // Abal\r\npoke(buf_features, s1_x, timeIndex, 0+5); // sLo_x\r\npoke(buf_features, s1_y, timeIndex, 0+6); // sLo_y\r\npoke(buf_features, 0,    timeIndex, 0+7); // sHi_x\r\npoke(buf_features, 0,    timeIndex, 0+8); // sHi_y\r\npoke(buf_features, 0,    timeIndex, 0+9); // phi\r\n\r\n// sort features buffer by frequency (so far we've been sorted by energy)\r\n// im unsure this is the way long term! but good for demo :)\r\n// gawd this is a cursed lil sort. where are the function pointers in genexpr ay!\r\nfor (i=1; i<numFeatures; i+=1)\r\n{\r\n    Wr_i = peek(buf_features, timeIndex, i*featureStride+1);\r\n    \r\n    for(k=0; k<featureStride; k+=1)\r\n    {\r\n        tmp_k = peek(buf_features, timeIndex, i*featureStride+k);\r\n        poke(tmpFeature, tmp_k, k); \r\n    }\r\n    \r\n    j=i-1;\r\n    while(j >= 0 && peek(buf_features, timeIndex, j*featureStride+1) < Wr_i)\r\n    {  \r\n        for (k=0; k<featureStride; k+=1)\r\n        {\r\n            tmp_k = peek(buf_features, timeIndex, j*featureStride+k);\r\n            poke(buf_features, tmp_k, timeIndex, (j+1)*featureStride+k);\r\n        }\r\n        j -= 1;\r\n    }\r\n    \r\n    for(k=0; k<featureStride; k+=1)\r\n    {\r\n        tmp_k = peek(tmpFeature, k);\r\n        poke(buf_features, tmp_k, timeIndex, (j+1)*featureStride+k);\r\n    }\r\n    \r\n}",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
