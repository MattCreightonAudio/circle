            {
                "box": {
                    "code": "require(\"circle_core_groupEnergy\");\r\n\r\ntimeIndex = in1;\r\nellipseStride = 5;\r\n    \r\n// initialise ellipses_local \r\nfor (i=0; i<numEllipses; i+=1) \r\n{\r\n    amp_i = peek(buf_ellipses, timeIndex, i*ellipseStride+1);\r\n\r\n    poke(ellipses_local, amp_i, i, 0);\r\n}\r\n\r\n// figure out the group energies Gk and pair energies Sk\r\ncircle_groupEnergy(ellipses_local, numEllipses, G, S);\r\n\r\nkNessWriteIdx = 1; // skip 0 - we'll use it for oneness later\r\nfor (i=0; i<numEllipses; i+=1)\r\n{\r\n    freq_i = peek(buf_ellipses, timeIndex, i*ellipseStride+0); \r\n    \r\n    for (j=i+1; j<numEllipses; j+=1)\r\n    {\r\n        freq_j = peek(buf_ellipses, timeIndex, j*ellipseStride+0);\r\n        \r\n        hiFreq = 1;\r\n        loFreq = 1;\r\n        \r\n        if (freq_i > freq_j) \r\n        {\r\n            hiFreq = freq_i;\r\n            loFreq = freq_j;\r\n        } \r\n        else \r\n        {\r\n            loFreq = freq_i;\r\n            hiFreq = freq_j;\r\n        }\r\n        \r\n        if (loFreq < 0.001) loFreq = 0.001;\r\n        freqRatio = hiFreq/loFreq;\r\n        \r\n        // pair energy for this pair\r\n        // S_j depends only on j, not on i. funky but it works. \r\n        S_j = peek(S, j);\r\n        \r\n        // write into kNesses buffer \r\n        // super weird indexing!\r\n        poke (kNesses, S_j, kNessWriteIdx, 0);\r\n        poke (kNesses, freqRatio, kNessWriteIdx, 1);\r\n        kNessWriteIdx += 1;\r\n    } \r\n}\r\n\r\npoke (kNesses, peek(G,0), 0, 0); // oneness energy (thats far out dudeee)\r\npoke (kNesses, 1, 0, 1);         // dummy oneness freq ratio of 1\r\n\r\n\r\nout1 = peek(kNesses, 0, 0); // oneness energy\r\nout2 = peek(kNesses, 1, 0); // 1-2ness energy\r\nout3 = peek(kNesses, 2, 0); // 1-3ness energy\r\nout4 = peek(kNesses, 3, 0); // 1-4ness energy\r\nout5 = peek(kNesses, 4, 0); // 2-3ness energy\r\nout6 = peek(kNesses, 5, 0); // 2-4ness energy\r\nout7 = peek(kNesses, 6, 0); // 3-4ness energy\r\n\r\nout8 = peek(kNesses,  0, 1); // oneness freqRatio\r\nout9 = peek(kNesses,  1, 1); // 1-2ness freqRatio\r\nout10 = peek(kNesses, 2, 1); // 1-3ness freqRatuo\r\nout11 = peek(kNesses, 3, 1); // 1-4ness freqRatio\r\nout12 = peek(kNesses, 4, 1); // 2-3ness freqRatio\r\nout13 = peek(kNesses, 5, 1); // 2-4ness freqRatio\r\nout14 = peek(kNesses, 6, 1); // 3-4ness freqRatio\r\n",
                    "fontface": 0,
