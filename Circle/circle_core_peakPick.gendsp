            {
                "box": {
                    "code": "numBins = in2;\r\npeakPickDepth = 2;\r\nnumPeaksRetained = numEllipses;\r\ntimeIndex = in1;\r\n\r\n\r\n// clear the peaks from last frame\r\nfor (i = 0; i<numPeaksRetained; i+=1)\r\n{\r\n    poke(best_peaks, 0, i, 0);\r\n    poke(best_peaks, 0, i, 1);\r\n}\r\n\r\n//iterate over channels\r\nfor (i = 0; i<numBins; i+=1)\r\n{\r\n    // look for local maxima\r\n    currBinVal = peek(buf_A0, timeIndex, i);\r\n    for (j = 1; j <= peakPickDepth; j+=1)\r\n    {\r\n        upper = peek(buf_A0, timeIndex, i+j);\r\n        lower = peek(buf_A0, timeIndex, i-j);    \r\n        \r\n        if (currBinVal < upper || currBinVal < lower)\r\n        {\r\n            currBinVal = 0;\r\n            break;\r\n        } \r\n\r\n    }\r\n    \r\n    // if we found local max, decide if it goes on the list of best peaks\r\n    if (currBinVal > 0)\r\n    {\r\n        currPeakIndex = 0;\r\n        currPeakVal = 0;\r\n\r\n        \r\n        //iterate over existing (ordered!) peaks\r\n        k = 0;\r\n        while (k < numPeaksRetained)\r\n        {\r\n            if (peek(best_peaks, k, 1) < currBinVal)\r\n            {\r\n                currPeakIndex = i;\r\n                currPeakVal = currBinVal;\r\n                break;\r\n            }\r\n            \r\n            k += 1;\r\n        }\r\n                \r\n        // if we broke out of the above loop\r\n        // then we need to update the best_peaks array\r\n        while (k < numPeaksRetained) \r\n        {\r\n            \r\n            // the loop body (below) preserves sortedness \r\n            // and we initialised to all zeroes which is sorted\r\n            // so we just (implicitly) discard the last value in \r\n            // the list and push all others down by one\r\n            \r\n            // (think of it as one iteration of an insertion sort)\r\n\r\n            tempIndex = peek(best_peaks, k, 0);\r\n            tempVal   = peek(best_peaks, k, 1);\r\n            \r\n            // extreme stupidness to get gen~ to understand peek/poke dependency\r\n            // note the || 1 meaning we ALWAYS go into this if statement! \r\n             \r\n            if (tempIndex == 0 || tempVal == 0 || 1) {\r\n                poke(best_peaks, currPeakIndex, k, 0);\r\n                poke(best_peaks, currPeakVal  , k, 1);\r\n                \r\n                currPeakIndex = tempIndex;\r\n                currPeakVal   = tempVal;\r\n            }    \r\n            \r\n            \r\n            k += 1;\r\n        }    \r\n    } \r\n}\r\n\r\n\r\n// iterate over best_peaks and collect information on them\r\nfor (i = 0; i< numPeaksRetained; i+=1)\r\n{\r\n    peakIndex = peek(best_peaks, i ,0);\r\n        \r\n    // get fractional bin index using quadratic interpolation\r\n    // algorithm discussed in :\r\n    // PARSHL: An Analysis/Synthesis Program for Non-Harmonic Sounds Based on a Sinusoidal Representation\r\n    // Smith & Serra 2005\r\n\r\n    // we're relying on maxMSP to do its own bounds-checking here\r\n    alpha = log (peek(buf_A0, timeIndex, peakIndex-1));\r\n    beta  = log (peek(buf_A0, timeIndex, peakIndex));\r\n    gamma = log (peek(buf_A0, timeIndex, peakIndex+1));\r\n    \r\n    // calculate p (our position relative to the centre of the bin in question)\r\n    // if the bounds check/ \"conditioning check\" on the quadratic fails,\r\n    // we implicitly accept p=0 as our best guess\r\n    p=0;\r\n    denominator = alpha + gamma - (2*beta) ;\r\n\r\n    if (denominator < -1e-7 && beta > alpha && beta > gamma)\r\n    {\r\n        \r\n        p = 0.5 * (alpha - gamma) / denominator;\r\n    }\r\n    \r\n    peakIndex_fract = peakIndex + p;\r\n\r\n    peakFreq = baseFreq * pow(freqRatio, peakIndex_fract);\r\n    peakAmp          = peek(best_peaks, i, 1);     \r\n    peakShape        = peek(buf_S,           timeIndex, peakIndex);\r\n    peakPsi          = peek(buf_psiPlus,     timeIndex, peakIndex);     \r\n    peakTau          = peek(buf_tau,         timeIndex, peakIndex);\r\n    peakAmp_unscaled = peek(buf_A0_unscaled, timeIndex, peakIndex);\r\n                                                                                         \r\n    poke(buf_out, peakFreq        , timeIndex, i*ellipseStride + 0);\r\n    poke(buf_out, peakAmp         , timeIndex, i*ellipseStride + 1);\r\n    poke(buf_out, peakShape       , timeIndex, i*ellipseStride + 2);\r\n    poke(buf_out, peakPsi         , timeIndex, i*ellipseStride + 3);\r\n    poke(buf_out, peakTau         , timeIndex, i*ellipseStride + 4);\r\n    poke(buf_out, peakAmp_unscaled, timeIndex, i*ellipseStride + 5);\r\n        \r\n}",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
