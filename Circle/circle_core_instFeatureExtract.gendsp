            {
                "box": {
                    "code": "require(\"circle_core_groupEnergy\");\r\nrequire(\"circle_core_A0RateCorrection\");\r\nrequire(\"circle_core_STauCart\");\r\n\r\ntimeIndex = in1;\r\n\r\n// initialise ellipses_local \r\nfor (i=0; i<numEllipses; i+=1) \r\n{\r\n    freq_i = peek(buf_ellipses, timeIndex, i*ellipseStride+0);\r\n    amp_i = peek(buf_ellipses, timeIndex, i*ellipseStride+1);\r\n\r\n    poke(ellipses_local, amp_i, i);\r\n}\r\n\r\n// figure out the group energies Gk and pair energies Sk\r\ncircle_groupEnergy(ellipses_local, numEllipses, G, S);\r\n\r\nfeatureWriteIdx = 1; // skip 0 - we'll use it for oneness later\r\n\r\nfor (i=1; i<numEllipses; i+=1) // iterate from 1 btw!\r\n{\r\n    freq_i = peek(buf_ellipses, timeIndex, i*ellipseStride+0); \r\n    \r\n    for (j=0; j<i; j+=1) // j is always less than i (thats why i starts at 1)\r\n    {\r\n        freq_j = peek(buf_ellipses, timeIndex, j*ellipseStride+0);\r\n        \r\n        \r\n        hiFreq = 1;\r\n        loFreq = 1;\r\n        lo = 0;\r\n        hi = 0;\r\n        \r\n        if (freq_i > freq_j) \r\n        {\r\n            hiFreq = freq_i;\r\n            loFreq = freq_j;\r\n            lo = j;\r\n            hi = i;\r\n        } \r\n        else \r\n        {\r\n            loFreq = freq_i;\r\n            hiFreq = freq_j;\r\n            lo = i;\r\n            hi = j;\r\n        }\r\n        \r\n        if (loFreq < 0.001) loFreq = 0.001;\r\n        freqRatio = hiFreq/loFreq;\r\n       \r\n        \r\n        // pair energy for this pair\r\n        // it depends only on i, not on j. funky but it works. \r\n        S_i = peek(S, i);\r\n                \r\n        // get vals for calculating features\r\n        shape_lo = peek(buf_ellipses, timeIndex, lo*ellipseStride+2);\r\n        shape_hi = peek(buf_ellipses, timeIndex, hi*ellipseStride+2);\r\n        psi_lo   = peek(buf_ellipses, timeIndex, lo*ellipseStride+3);\r\n        psi_hi   = peek(buf_ellipses, timeIndex, hi*ellipseStride+3);\r\n        tau_lo   = peek(buf_ellipses, timeIndex, lo*ellipseStride+4);\r\n        tau_hi   = peek(buf_ellipses, timeIndex, hi*ellipseStride+4);\r\n        \r\n        // these are the non-rate-scaled vals btw. hence the +5 offset\r\n        A_lo     = peek(buf_ellipses, timeIndex, lo*ellipseStride+5);\r\n        A_hi     = peek(buf_ellipses, timeIndex, hi*ellipseStride+5);\r\n        \r\n        \r\n        // calculate features\r\n        energy = S_i;\r\n        Asum = A_lo + A_hi;\r\n        if (abs(Asum) < 0.0001) Asum = 0.0001 * sign(Asum);\r\n        Abal = (A_hi - A_lo) / (2 * Asum) + 0.5;          \r\n        phi_feature = phasewrap((psi_lo - tau_lo) * freqRatio - (psi_hi - tau_hi));\r\n        Sp_lo, Sm_lo, Th_lo, Tv_lo, Tu_lo, Td_lo = tauSToCart(tau_lo,shape_lo);\r\n        Sp_hi, Sm_hi, Th_hi, Tv_hi, Tu_hi, Td_hi = tauSToCart(tau_hi,shape_hi); \r\n        \r\n        // blank out entries where the freqratio is very high or the energy very low\r\n        // since that means we didnt get a good lock\r\n        if (freqRatio > 17 || abs(Asum) < 0.12 || energy < 0.1)\r\n        {\r\n            energy = 0;\r\n            freqRatio = 0;\r\n            loFreq = 0;\r\n            Asum = 0;\r\n            Abal = 0;\r\n            phi_feature = 0;\r\n            \r\n            Sp_lo = 0;\r\n            Sm_lo = 0;\r\n            Th_lo = 0;\r\n            Tv_lo = 0;\r\n            Tu_lo = 0;\r\n            Td_lo = 0;\r\n\r\n            Sp_hi = 0;\r\n            Sm_hi = 0;\r\n            Th_hi = 0;\r\n            Tv_hi = 0;\r\n            Tu_hi = 0;\r\n            Td_hi = 0;\r\n\r\n        }\r\n        \r\n        // write into features buffer\r\n        poke(buf_instFeatures, energy,      timeIndex, featureWriteIdx*featureStride+0); // E\r\n        poke(buf_instFeatures, freqRatio,   timeIndex, featureWriteIdx*featureStride+1); // Wr\r\n        poke(buf_instFeatures, loFreq,      timeIndex, featureWriteIdx*featureStride+2); // W0\r\n        poke(buf_instFeatures, Asum,        timeIndex, featureWriteIdx*featureStride+3); // Asum\r\n        poke(buf_instFeatures, Abal,        timeIndex, featureWriteIdx*featureStride+4); // Abal\r\n        poke(buf_instFeatures, phi_feature, timeIndex, featureWriteIdx*featureStride+5); // phi\r\n        \r\n        poke(buf_instFeatures, Sp_lo, timeIndex, featureWriteIdx*featureStride+6);  // S+_lo\r\n        poke(buf_instFeatures, Sm_lo, timeIndex, featureWriteIdx*featureStride+7);  // S-_lo\r\n        poke(buf_instFeatures, Th_lo, timeIndex, featureWriteIdx*featureStride+8);  // Th_lo\r\n        poke(buf_instFeatures, Tv_lo, timeIndex, featureWriteIdx*featureStride+9);  // Tv_lo\r\n        poke(buf_instFeatures, Tu_lo, timeIndex, featureWriteIdx*featureStride+10); // Tu_lo\r\n        poke(buf_instFeatures, Td_lo, timeIndex, featureWriteIdx*featureStride+11); // Td_lo\r\n        poke(buf_instFeatures, Sp_hi, timeIndex, featureWriteIdx*featureStride+12); // S+_hi\r\n        poke(buf_instFeatures, Sm_hi, timeIndex, featureWriteIdx*featureStride+13); // S-_hi\r\n        poke(buf_instFeatures, Th_hi, timeIndex, featureWriteIdx*featureStride+14); // Th_hi\r\n        poke(buf_instFeatures, Tv_hi, timeIndex, featureWriteIdx*featureStride+15); // Tv_hi\r\n        poke(buf_instFeatures, Tu_hi, timeIndex, featureWriteIdx*featureStride+16); // Tu_hi\r\n        poke(buf_instFeatures, Td_hi, timeIndex, featureWriteIdx*featureStride+17); // Td_hi\r\n                    \r\n        featureWriteIdx += 1;\r\n    } \r\n    \r\n}\r\n\r\n// calculate oneness features \r\n// use non-scaled A (addr 0+5 not 0+1)\r\nE_1        = peek(G,0);\r\nW0_1       = peek(buf_ellipses, timeIndex, 0+0);\r\nshape_1    = peek(buf_ellipses, timeIndex, 0+2);\r\ntau_1      = peek(buf_ellipses, timeIndex, 0+4);\r\nA_1        = peek(buf_ellipses, timeIndex, 0+5);\r\n\r\nSp_lo, Sm_lo, Th_lo, Tv_lo, Tu_lo, Td_lo = tauSToCart(tau_1,shape_1);\r\n\r\nif (abs(A_1) < 0.1 || E_1 < 0.1)\r\n{\r\n    E_1     = 0;\r\n    W0_1    = 0;\r\n    shape_1 = 0;\r\n    tau_1   = 0;\r\n    A_1     = 0;\r\n    Sp_lo   = 0;\r\n    Sm_lo   = 0; \r\n    Th_lo   = 0; \r\n    Tv_lo   = 0; \r\n    Tu_lo   = 0; \r\n    Td_lo   = 0;\r\n}\r\n\r\n// write oneness features \r\n// we hardcode the meaningless ones to suitable values\r\n// (this representation IS consistent with the model and stuff - \r\n// just with Abal = 0. So in a sense its a 2-Ellipse curve like any other)\r\npoke(buf_instFeatures, E_1,   timeIndex, 0+0); // E\r\npoke(buf_instFeatures, 1,     timeIndex, 0+1); // Wr\r\npoke(buf_instFeatures, W0_1,  timeIndex, 0+2); // W0\r\npoke(buf_instFeatures, A_1,   timeIndex, 0+3); // Asum\r\npoke(buf_instFeatures, 0,     timeIndex, 0+4); // Abal\r\npoke(buf_instFeatures, 0,     timeIndex, 0+5); // phi\r\npoke(buf_instFeatures, Sp_lo, timeIndex, 0+6);  // S+_lo\r\npoke(buf_instFeatures, Sm_lo, timeIndex, 0+7);  // S-_lo\r\npoke(buf_instFeatures, Th_lo, timeIndex, 0+8);  // Th_lo\r\npoke(buf_instFeatures, Tv_lo, timeIndex, 0+9);  // Tv_lo\r\npoke(buf_instFeatures, Tu_lo, timeIndex, 0+10);  // Tu_lo\r\npoke(buf_instFeatures, Td_lo, timeIndex, 0+11); // Td_lo\r\npoke(buf_instFeatures, 0,     timeIndex, 0+12); // S+_hi\r\npoke(buf_instFeatures, 0,     timeIndex, 0+13); // S-_hi\r\npoke(buf_instFeatures, 0,     timeIndex, 0+14); // Th_hi\r\npoke(buf_instFeatures, 0,     timeIndex, 0+15); // Tv_hi\r\npoke(buf_instFeatures, 0,     timeIndex, 0+16); // Tu_hi\r\npoke(buf_instFeatures, 0,     timeIndex, 0+17); // Td_hi\r\n\r\n// sort features buffer by frequency (so far we've been sorted by energy)\r\n// im unsure this is the way long term! but good for demo :)\r\n// gawd this is a cursed lil sort. where are the function pointers in genexpr ay!\r\nfor (i=1; i<numInstFeatures; i+=1)\r\n{\r\n    Wr_i = peek(buf_instFeatures, timeIndex, i*featureStride+1);\r\n    \r\n    for(k=0; k<featureStride; k+=1)\r\n    {\r\n        tmp_k = peek(buf_instFeatures, timeIndex, i*featureStride+k);\r\n        poke(tmpFeature, tmp_k, k); \r\n    }\r\n    \r\n    j=i-1;\r\n    while(j >= 0 && peek(buf_instFeatures, timeIndex, j*featureStride+1) > Wr_i)\r\n    {  \r\n        for (k=0; k<featureStride; k+=1)\r\n        {\r\n            tmp_k = peek(buf_instFeatures, timeIndex, j*featureStride+k);\r\n            poke(buf_instFeatures, tmp_k, timeIndex, (j+1)*featureStride+k);\r\n        }\r\n        j -= 1;\r\n    }\r\n    \r\n    for(k=0; k<featureStride; k+=1)\r\n    {\r\n        tmp_k = peek(tmpFeature, k);\r\n        poke(buf_instFeatures, tmp_k, timeIndex, (j+1)*featureStride+k);\r\n    }\r\n    \r\n}\r\n\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
