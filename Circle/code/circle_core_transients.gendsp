            {
                "box": {
                    "code": "lerp(curr, tgt, ms)\r\n{\r\n    alpha = 1 / (max(1, ms * 0.001 * samplerate));\r\n    return curr + alpha * (tgt - curr);\r\n}\r\n\r\nDelay heading_delay (44100);\r\n\r\nHistory xDelta_lerp;\r\nHistory yDelta_lerp;\r\nHistory curve_lerp;\r\nHistory rate_lerp_long;\r\nHistory gestOn_last;\r\nHistory velocity;\r\nHistory release;\r\nHistory xStart;\r\nHistory yStart;\r\nHistory rate_last;\r\nHistory thrustRatio_out;\r\n\r\n\r\ngestOn = in3;\r\n\r\nxAbs = in1;\r\nyAbs = in2;\r\n\r\nif (gestOn != gestOn_last)\r\n{\r\n    if (gestOn)\r\n    {\r\n        xStart = xAbs;\r\n        yStart = yAbs;\r\n        xDelta_lerp = 0;\r\n        yDelta_lerp = 0;\r\n        curve_lerp  = 0;\r\n        rate_lerp_long = 0.0001;\r\n        rate_last = 0;\r\n    }\r\n    else\r\n    {\r\n        releaseMultiplier = rate_last/rate_lerp_long; // rate_lerp_long should never be 0 so this is ok\r\n        release = releaseMultiplier * (baseRelease * thrustReleaseAmount); \r\n    }\r\n    gestOn_last = gestOn;\r\n}\r\n\r\nwindowTimeSamps = mstosamps(windowTimeMs);\r\ncurveTimeSamps = mstosamps(curveTimeMs);\r\n\r\nxRel = xAbs - xStart;\r\nyRel = yAbs - yStart;\r\nabradius = cartopol(xRel, yRel);\r\n\r\nxDelta = delta(in1) * samplerate;\r\nyDelta = delta(in2) * samplerate;\r\n\r\nxDelta_lerp = lerp(xDelta_lerp, xDelta, windowTimeMs);\r\nyDelta_lerp = lerp(yDelta_lerp, yDelta, windowTimeMs);\r\n\r\nrate, heading = cartopol(xDelta_lerp, yDelta_lerp);\r\nrate_last = rate;\r\ncurve = wrap(heading - heading_delay.read(windowTimeSamps), -pi, pi) * samplerate;\r\nheading_delay.write(heading);\r\n\r\ncurve_lerp = lerp(curve_lerp, curve, curveTimeMs);\r\n\r\nrate_lerp_long = lerp(rate_lerp_long, rate, releaseDecisionWindow);\r\n\r\nif(gestOn)\r\n{\r\n    velocity = rate;\r\n    thrustRatio_out = rate_last/rate_lerp_long;\r\n}\r\nelse\r\n{\r\n    velocity = lerp(velocity, 0, release);\r\n}\r\n\r\nout1 = xDelta_lerp;\r\nout2 = yDelta_lerp;\r\nout3 = rate;\r\nout4 = heading; \r\nout5 = curve_lerp / mstosamps(curveTimeMs);\r\nout6 = velocity;\r\nout7 = release;\r\nout8 = xRel;\r\nout9 = yRel;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
