            {
                "box": {
                    "code": "lerp(curr, tgt, ms)\r\n{\r\n    alpha = 1 / (max(1, ms * 0.001 * samplerate));\r\n    return curr + alpha * (tgt - curr);\r\n}\r\n\r\nDelay xDelta_delay (44100);\r\nDelay yDelta_delay (44100);\r\nDelay heading_delay(44100);\r\nDelay curve_delay  (44100);\r\nDelay thrust_delay (44100);\r\n\r\nHistory xDelta_mean;\r\nHistory yDelta_mean;\r\nHistory curve_mean;\r\nHistory release;\r\nHistory gestOn_last;\r\nHistory velocity;\r\n\r\ngestOn = in3;\r\n\r\ndelaySamps = mstosamps(windowTimeMs);\r\ndelaySamps_r = 1/delaySamps;\r\n\r\ncurveDelaySamps = mstosamps(curveWindowMs);\r\ncurveDelaySamps_r = 1/curveDelaySamps;\r\n\r\nxAbs = in1;\r\nyAbs = in2;\r\nxDelta = delta(in1) * samplerate;\r\nyDelta = delta(in2) * samplerate;\r\n\r\nxDelta_mean = xDelta_mean + xDelta * delaySamps_r - xDelta_delay.read(delaySamps) * delaySamps_r;\r\nyDelta_mean = yDelta_mean + yDelta * delaySamps_r - yDelta_delay.read(delaySamps) * delaySamps_r;\r\n\r\nxDelta_delay.write(xDelta);\r\nyDelta_delay.write(yDelta);\r\n\r\nrate, heading = cartopol(xDelta_mean, yDelta_mean);\r\ncurve = wrap(heading - heading_delay.read(delaySamps), -pi, pi) * samplerate;\r\nheading_delay.write(heading);\r\n\r\ncurve_mean = curve_mean + curve * curveDelaySamps_r - curve_delay.read(curveDelaySamps) * curveDelaySamps_r;\r\ncurve_delay.write(curve);\r\n\r\nif (gestOn != gestOn_last)\r\n{\r\n    if (!gestOn)\r\n    {\r\n        release = min(rate*releaseMultiplier,releaseMax);\r\n    }\r\n    gestOn_last = gestOn;\r\n}\r\nif(gestOn)\r\n{\r\n    velocity = rate;\r\n}\r\nelse\r\n{\r\n    velocity = lerp(velocity, 0, release);\r\n}\r\n\r\nout1 = xDelta_mean;\r\nout2 = yDelta_mean;\r\nout3 = rate;\r\nout4 = heading; \r\nout5 = curve_mean * curveDelaySamps_r;\r\nout6 = velocity;\r\n//out7 = 1 / (max(1, 1000 * 0.001 * samplerate));\r\nout7 = release;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
