            {
                "box": {
                    "code": "apply_deadZone(val, amt)\r\n{\r\n    if (val < amt)\r\n    {\r\n        return 0;\r\n    }\r\n    else if (val > (1-amt))\r\n    {\r\n        return 1;\r\n    }\r\n    else { \r\n        return (val - amt) / (1-2*amt);\r\n    }\r\n}\r\n\r\nParam deadZone(0);\r\nData a_outs(4);\r\n\r\naBal = in1;\r\naSum = in2;\r\nSp   = in3;\r\nSm   = in4;\r\n\r\ntSum = 1 - (Sp + Sm);\r\n\r\nTh_norm = in5/tSum;\r\nTv_norm = in6/tSum;\r\nTu_norm = in7/tSum;\r\nTd_norm = in8/tSum;\r\n\r\na1 = (1-aBal) * aSum;\r\n\r\na_index = max(0, a1 - 0.1);\r\na_index = clip(a_index*4.5, 0, 4);\r\n\r\na_floor = floor(a_index);\r\na_fract = apply_deadZone(a_index - a_floor, deadZone);\r\n\r\ni=0;\r\nfor (i=0; i<4; i=i+1)\r\n{\r\n\ta_amt = (a_floor == i-1) * a_fract\r\n\t      + (a_floor == i)   * (1-a_fract);\r\n\r\n\tif (i==3 && a_floor > i)\r\n    {\r\n        a_amt = 1;\r\n    }\r\n\r\n    poke(a_outs, a_amt, i);\r\n}\r\n\r\nout1 = peek(a_outs, 0) * Th_norm;\r\nout2 = peek(a_outs, 0) * Tu_norm;\r\nout3 = peek(a_outs, 0) * Tv_norm;\r\nout4 = peek(a_outs, 0) * Td_norm;\r\n\r\nout5 = peek(a_outs, 1) * Th_norm;\r\nout6 = peek(a_outs, 1) * Tu_norm;\r\nout7 = peek(a_outs, 1) * Tv_norm;\r\nout8 = peek(a_outs, 1) * Td_norm;\r\n\r\nout9  = peek(a_outs, 2) * Th_norm;\r\nout10 = peek(a_outs, 2) * Tu_norm;\r\nout11 = peek(a_outs, 2) * Tv_norm;\r\nout12 = peek(a_outs, 2) * Td_norm;\r\n\r\nout13 = peek(a_outs, 3) * Th_norm;\r\nout14 = peek(a_outs, 3) * Tu_norm;\r\nout15 = peek(a_outs, 3) * Tv_norm;\r\nout16 = peek(a_outs, 3) * Td_norm;\r\n\r\n",
