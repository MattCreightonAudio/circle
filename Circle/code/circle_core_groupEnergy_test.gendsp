            {
                "box": {
                    "code": "// get the group energy extractor\r\nrequire(\"circle_core_groupEnergy\");\r\n\r\n// data buffers\r\nData G(6);\r\nData S(6);\r\n\r\n// sortedness is assumed! calling code will need the indices anyway\r\npoke(inputs, in1, 0);\r\npoke(inputs, in2, 1);\r\npoke(inputs, in3, 2);\r\npoke(inputs, in4, 3);\r\npoke(inputs, in5, 4);\r\npoke(inputs, in6, 5);\r\n\r\n// hardcoded cause the inputs are hardcoded\r\nnumElements = 6;\r\n\r\n// calculate group energy whoop\r\ncircle_groupEnergy(inputs, numElements, G, S);\r\n\r\nout1 = peek(G, 0);\r\nout2 = peek(G, 1);\r\nout3 = peek(G, 2);\r\nout4 = peek(G, 3);\r\nout5 = peek(G, 4);\r\nout6 = peek(G, 5);\r\n\r\nout7  = peek(S, 1); // not 0! \r\nout8  = peek(S, 2);\r\nout9  = peek(S, 3);\r\nout10 = peek(S, 4);\r\nout11 = peek(S, 5);\r\n",
