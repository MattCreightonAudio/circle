            {
                "box": {
                    "code": "soft_saw(p, k) {\r\n    p = p - floor(p);\r\n    val = 0.0;\r\n    if (p < k) {\r\n        x = p / k;\r\n        val = x * x - 1.0;\r\n    } else if (p > 1.0 - k) {\r\n        x = (p - (1.0 - k)) / k;\r\n        val = 2.0 * x - x * x - 1.0;\r\n    } else {\r\n        val = 2.0 * p - 1.0;\r\n    }\r\n    return val + k;\r\n}\r\n\r\nsoft_square(p, k) {\r\n    p = p - floor(p);\r\n    val = 0.0;\r\n    if (p < k) {\r\n        val = 3.0 * (p/k) * (p/k) - 2.0 * (p/k) * (p/k) * (p/k);\r\n    } else if (p < 0.5) {\r\n        val = 1.0;\r\n    } else if (p < 0.5 + k) {\r\n        p2 = (p - 0.5) / k;\r\n        val = 1.0 - (3.0 * p2 * p2 - 2.0 * p2 * p2 * p2);\r\n    } else if (p < 1.0 - k) {\r\n        val = -1.0;\r\n    } else {\r\n        p3 = (p - (1.0 - k)) / k;\r\n        val = -1.0 + (3.0 * p3 * p3 - 2.0 * p3 * p3 * p3);\r\n    }\r\n    return val;\r\n}\r\n\r\nosc_core(p, odds, evens, k)\r\n{\r\n    sq = soft_square(p, k);\r\n    saw_oct = soft_saw(2.0 * p, k);\r\n    sin_fund = sin(2.0 * pi * p);\r\n    \r\n    fund_amplitude = (4.0 / pi);\r\n    \r\n    high_odds = 0.5 * (sq - fund_amplitude * sin_fund);\r\n    even_harmonics = 0.5 * saw_oct;\r\n    \r\n    f_amp = 1.0 - odds * (1.0 - 2.0 / pi);\r\n    fund = f_amp * sin_fund;\r\n    \r\n    \r\n    return fund /* * (min(1,odds+1-evens))*/ + high_odds * odds + even_harmonics * evens;\r\n}\r\n\r\ndrive(samp, drive, bias)\r\n{\r\n    \r\n    return(tanh(samp * (1+drive) + bias) - tanh(bias)) / tanh(1+drive+bias/2);\r\n}\r\n\r\nHistory mainPhasor(0);\r\nParam softK(0.3);\r\nParam numHarms(16);\r\n\r\nfreq = in1;\r\nodds = in2;\r\nevens =  in3;\r\ndriveAmt = in4;\r\nphaseOffset = in5;\r\n\r\ndeltaT = 1/samplerate;\r\nmainPhasor = mainPhasor + freq * deltaT;\r\nphase = mainPhasor + phaseOffset;\r\n\r\nsum = 0;\r\nfor (i=0; i<numHarms; i=i+1)\r\n{\r\n\tratio = peek(harmRatios, i);\r\n\tlevel = peek(harmLevels, i);\r\n\tp = phase * ratio;\r\n\tsum = sum + osc_core(p, odds, evens, softK) * level;\r\n}\r\n\r\n// drive it!\r\nout1 = sum * (1-driveAmt*driveAmt) + drive(sum,  20,  0.2) * driveAmt*driveAmt * 0.5;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
