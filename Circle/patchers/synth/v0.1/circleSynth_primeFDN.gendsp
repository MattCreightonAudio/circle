        "classnamespace": "dsp.gen",
        "rect": [ -40.0, 180.0, 1213.0, 642.0 ],
        "boxes": [
            {
                "box": {
                    "code": "// 4-Channel Prime-Number FDN Cavity\n// Inputs:\n//   in1: Audio Input (from your synth or filter output)\n//\n// Named Parameters:\n//   cavitySize:  Scales the dimensions of the air cavity (0.5 to 2.5)\n//   cavityDecay: Master decay rate (0.0 to 0.98) - Controls RT60\n//   woodDamp:    One-pole LPF damping coefficient in feedback (0.0 to 0.95)\n//   cavityGain:  Gain multiplier for the wet resonant path (1.0 to 8.0)\n//   cavityMix:   Dry/Wet blend (0.0 = pure dry, 1.0 = pure wet cavity)\n\nParam cavitySize(1.0);\nParam cavityDecay(0.8);\nParam woodDamp(0.3);\nParam cavityGain(4.0); // Compenses for structural scaling attenuation\nParam cavityMix(0.5);  // Built-in dry/wet mixer (Now 1.0 by default!)\n\n// 1. Declare Delay Buffers (Maximum size of 8192 samples)\nDelay d1(8192);\nDelay d2(8192);\nDelay d3(8192);\nDelay d4(8192);\n\n// Declare Feedback Lowpass Filter States\nHistory lp1(0), lp2(0), lp3(0), lp4(0);\n\n// 2. Scale delays dynamically for Sample Rate and Cavity Size\nsr_ratio = samplerate / 44100.0;\nt1 = max(1.0, 131.0 * sr_ratio * cavitySize);\nt2 = max(1.0, 239.0 * sr_ratio * cavitySize);\nt3 = max(1.0, 373.0 * sr_ratio * cavitySize);\nt4 = max(1.0, 521.0 * sr_ratio * cavitySize);\n\n// 3. Read from delay lines\ny1 = d1.read(t1);\ny2 = d2.read(t2);\ny3 = d3.read(t3);\ny4 = d4.read(t4);\n\n// 4. One-Pole Wood Absorption Damping\nlp1 = lp1 * woodDamp + y1 * (1.0 - woodDamp);\nlp2 = lp2 * woodDamp + y2 * (1.0 - woodDamp);\nlp3 = lp3 * woodDamp + y3 * (1.0 - woodDamp);\nlp4 = lp4 * woodDamp + y4 * (1.0 - woodDamp);\n\n// 5. Unitary Hadamard Matrix Mixing (Energy Conservative)\nm1 = (lp1 + lp2 + lp3 + lp4) * 0.5;\nm2 = (lp1 - lp2 + lp3 - lp4) * 0.5;\nm3 = (lp1 + lp2 - lp3 - lp4) * 0.5;\nm4 = (lp1 - lp2 - lp3 + lp4) * 0.5;\n\n// 6. Inject Input and write back feedback with decay\nin_scaled = in1 * 0.25;\n\nd1.write(in_scaled + m1 * cavityDecay);\nd2.write(in_scaled + m2 * cavityDecay);\nd3.write(in_scaled + m3 * cavityDecay);\nd4.write(in_scaled + m4 * cavityDecay);\n\n// 7. Process Wet Output and Mix\n// Calculate the average of diffuse reflections\nwet_raw = (y1 + y2 + y3 + y4) * 0.25;\n\n// Apply master gain compensation to the wet signal\nwet_compensated = wet_raw * cavityGain;\n\n// Output a seamless mix of the dry input and wet cavity\nout1 = mix(in1, wet_compensated, cavityMix);",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-5",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 63.0, 85.0, 646.0, 707.0 ]
                }
