            {
                "box": {
                    "code": "apply_deadZone(val, amt)\r\n{\r\n    if (val < amt)\r\n    {\r\n        return 0;\r\n    }\r\n    else if (val > (1-amt))\r\n    {\r\n        return 1;\r\n    }\r\n    else { \r\n        return (val - amt) / (1-2*amt);\r\n    }\r\n}\r\n\r\nParam deadZone(0);\r\nData outs(4, 4);\r\n\r\nASumIndex = max(0, in1-0.1);\r\nASumIndex = clip(ASumIndex*4.5, 0, 4);\r\ntauIndex = ((in2 + pi/2) / (pi)) * 4;\r\n\r\nA_floor = floor(ASumIndex);\r\nA_fract = apply_deadZone(ASumIndex - A_floor, deadZone);\r\n\r\ntau_floor = floor(tauIndex);\r\ntau_fract = apply_deadZone(tauIndex - tau_floor, deadZone);\r\n\r\ni=0; \r\nj=0;\r\nfor (i=0; i<4; i=i+1)\r\n{\r\n    for (j=0; j<4; j=j+1)\r\n    {\r\n        A_amt   = (A_floor == i-1) *    A_fract\r\n                + (A_floor == i)   * (1-A_fract);\r\n        \r\n        if (i==3 && A_floor > i)\r\n        {\r\n            A_amt = 1;\r\n        }\r\n\r\n        tau_amt = (tau_floor == j-1) * tau_fract\r\n                + (tau_floor == j)   * (1-tau_fract);\r\n                \r\n        if (j == 0)\r\n        {\r\n           tau_amt += (tau_floor == 3) * tau_fract;     \r\n        }    \r\n        \r\n        outVal = A_amt*tau_amt;\r\n        poke(outs, outVal, i, j);\r\n    }    \r\n}\r\n\r\nout1 = peek(outs, 0, 0);\r\nout2 = peek(outs, 0, 1);\r\nout3 = peek(outs, 0, 2);\r\nout4 = peek(outs, 0, 3);\r\n\r\nout5 = peek(outs, 1, 0);\r\nout6 = peek(outs, 1, 1);\r\nout7 = peek(outs, 1, 2);\r\nout8 = peek(outs, 1, 3);\r\n\r\nout9 = peek(outs, 2, 0);\r\nout10 = peek(outs, 2, 1);\r\nout11 = peek(outs, 2, 2);\r\nout12 = peek(outs, 2, 3);\r\n\r\n\r\nout13 = peek(outs, 3, 0);\r\nout14 = peek(outs, 3, 1);\r\nout15 = peek(outs, 3, 2);\r\nout16 = peek(outs, 3, 3);\r\n\r\nout17 = tauIndex;\r\n",
