            {
                "box": {
                    "code": "// SSB Frequency Shifter (Bipolar)\n// Inputs:\n//   in1: I (In-phase signal from hilbert~ left outlet)\n//   in2: Q (Quadrature signal from hilbert~ right outlet)\n//   in3: Delta F (Bipolar frequency shift in Hz)\n\nHistory phase(0);\n\ndf = in3;                    // Bipolar frequency shift in Hz\ndf_abs = abs(df);            // Absolute rate for the phase increment\ndf_sign = sign(df);          // 1 for positive, -1 for negative, 0 for static\n\n// 1. Accumulate phase for the shift frequency\nphase_step = df_abs / samplerate;\nphase = wrap(phase + phase_step, 0.0, 1.0);\n\n// 2. Generate the quadrature carrier oscillators\nc_cos = cos(phase * twopi);\nc_sin = sin(phase * twopi);\n\n// 3. Single-Sideband Modulation\n// Upward shift:   I * cos - Q * sin\n// Downward shift: I * cos + Q * sin\n// By multiplying the sin term by the sign of df, we get perfect bipolar control!\nout1 = (in1 * c_cos) + (df_sign * in2 * c_sin);",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 110.0, 142.0, 589.0, 424.0 ]
                }
