            {
                "box": {
                    "code": "uRound_maxDenom3(k)\r\n{\r\n    // we're assuming k>0 here, hence \"uRound\"\r\n    whole = floor(k);\r\n    fract = k - whole;\r\n    \r\n    // round the fractional part in  sixths\r\n    n = round(fract * 6); \r\n    \r\n    // after these if statments the possible values for the fractional part are:\r\n    // 0/6 == 0\r\n    // 2/6 == 1/3\r\n    // 3/6 == 1/2\r\n    // 4/6 == 2/3\r\n    // this gives all the possible fractional values with max denom 3\r\n    // integers have a stronger \"attraction\" than other numbers\r\n    if (n == 1) \r\n    {\r\n        n = 0;\r\n    }    \r\n    if (n == 5) \r\n    {\r\n        whole += 1;\r\n        n = 0;\r\n    }\r\n    \r\n    return whole + n/6;\r\n}\r\n\r\nuRound_maxDenom4(k)\r\n{\r\n    // we're assuming k>0 here, hence \"uRound\"\r\n    whole = floor(k);\r\n    fract = k - whole;\r\n    \r\n    // round fractional part in 12ths\r\n    n = round (fract * 12);  \r\n    \r\n    // after these if statements the possible values for the fractional part are:\r\n    // 0/12 == 0\r\n    // 3/12 == 1/4\r\n    // 4/12 == 1/3\r\n    // 6/12 == 1/2\r\n    // 8/12 == 2/3\r\n    // 9/12 == 3/4\r\n    // this gives all the possible fractional values with max denom 4\r\n    // integers and half-integers have a stronger \"attraction\" than other numbers - \r\n    // with integers having the strongest pull of all.\r\n    if (n >= 10) whole += 1;\r\n    if (n <= 2 || n >= 10) n = 0;\r\n    if (n == 5 || n == 7)  n = 6;\r\n    \r\n    return whole + n/12;\r\n}\r\n\r\nlerp(current, target, lerpAmount)\r\n{\r\n    return current + lerpAmount * (target - current);\r\n}\r\n\r\nsmooth(current, target, freq, cycles)\r\n{\r\n    // find time constant for smoothing\r\n    // as a rule of theumb the \"response time\" is 3 time constants\r\n    // so multiply period by number of cycles and triple it\r\n    period = 1/freq;\r\n    timeConst = 3 * period * cycles;\r\n    \r\n    // perform smoothing\r\n    return lerp(current, target, timeConst);\r\n}\r\n\r\ntimeIndex = in1;\r\n\r\nbuf_feature_idx = 0;\r\nfor (i=0; i<numSmoothedFeatures; i+=1)\r\n{\r\n    Wr_target = uRound_maxDenom3( peek(buf_ratiosOfInterest,i) );  \r\n    \r\n    // given our current Wr_target, figure out where in buf_features we should be looking\r\n    // we're relying on features being sorted by Wr here btw \r\n    Wr_current = -1;\r\n    while (Wr_current < Wr_target && buf_feature_idx < numFeatures) {\r\n\r\n        Wr_current = uRound_maxDenom3( peek(buf_features,timeIndex,buf_feature_idx*featureStride+1) );  \r\n        \r\n        if (Wr_current < Wr_target) buf_feature_idx += 1;\r\n        \r\n    }\r\n    \r\n    //////////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n    // lets run down the conditions at while loop exit cause its a bit fucky -\r\n    //\r\n    // either : buf_feature_idx ran off the end of buf_features (while Wr_current < Wr_target was still true)\r\n    // or     : Wr_current == Wr_target\r\n    // or     : Wr_current > Wr_target (and buf_feature_idx holds the LOWEST value for which this is true)\r\n    //\r\n    // if Wr_current = Wr_target, great. Thats a hit. No cleanup to do.\r\n    // (although its a bit arbitrary if there were multiple indices where Wr_current == Wr_target)\r\n    //\r\n    // if we ran off the end of buf_features - that means Wr_target is larger than any of the Wrs in \r\n    // buf_features. And there's no cleanup to do since we WANT an early exit on the next i also\r\n    //\r\n    // if Wr_current > Wr_target - well, we know that (buf_feature_idx-1) gives an Wr smaller \r\n    // than our current target. And we know that our next Wr_target will be even bigger.\r\n    // so the smallest index which could result in a hit is ALREADY held in buf_feature_idx.\r\n    // again, no cleanup\r\n    //\r\n    // so it really LOOKS fragile but all the cases are indeed handled. phewf!\r\n    ///////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n\r\n    // this if() is always entered (note the || 1) \r\n    // but it makes gen~ notice the buf_feature_idx dependency and generate the right code \r\n    if (buf_feature_idx || 1) \r\n    {\r\n        // determine whether we \"smooth toward a feature\" or whether we \"smooth toward zero\"\r\n        // Wr_test is working around another gen~ \"quirk\", do not remove\r\n        Wr_test = uRound_maxDenom3(Wr_current);\r\n        if (Wr_test == Wr_target) {\r\n\r\n            // hit - smooth the values in smoothedFeatures towards the feature we identified \r\n            \r\n            // get W0 \r\n            // we dont smooth W0 we just take the new value as gospel and write it in\r\n            // got to do this first so that other things can be smoothed correctly\r\n            loFreq = peek(buf_features, timeIndex, buf_feature_idx*featureStride+2);\r\n            poke(buf_smoothedFeatures, loFreq, timeIndex, i*featureStride+2);\r\n            poke(smoothedFeatures_old, loFreq, i*featureStride+2);\r\n            \r\n            // smooth and write E \r\n            E_current = peek(smoothedFeatures_old, i*featureStride+0);\r\n            E_target  = peek(buf_features, timeIndex, buf_feature_idx*featureStride+0);\r\n            E_smooth  = lerp(E_current, E_target, 0.001);\r\n            poke(buf_smoothedFeatures, E_smooth, timeIndex, i*featureStride+0);\r\n            poke(smoothedFeatures_old, E_smooth, i*featureStride+0);\r\n            \r\n            // write Wr (no smoothing)\r\n            poke(buf_smoothedFeatures, Wr_target, timeIndex, i*featureStride+1);\r\n            poke(smoothedFeatures_old, Wr_target, i*featureStride+1);\r\n\r\n            // write all the other values\r\n            // j starts at 3 cause we're skipping E, W0 and Wr (handled above)\r\n            for(j=3; j<featureStride; j+=1) \r\n            {\r\n                // read, smooth, write\r\n                val_current = peek(smoothedFeatures_old, i*featureStride+j);\r\n                val_target  = peek(buf_features, timeIndex, buf_feature_idx*featureStride+j);\r\n                val_smooth  = lerp(val_current, val_target, 0.001); \r\n                poke(buf_smoothedFeatures, val_smooth, timeIndex, i*featureStride+j);\r\n                poke(smoothedFeatures_old, val_smooth, i*featureStride+j);\r\n            }\r\n            \r\n        } \r\n        else // miss - smooth the values in smoothedFeatures towards 0\r\n        {\r\n            // get W0, write into the new timeIndex (no smoothing)\r\n            // we do this first bc we need the value to smooth other things correctly\r\n            loFreq = peek(smoothedFeatures_old, i*featureStride+2);\r\n            poke(buf_smoothedFeatures, loFreq, timeIndex, i*featureStride+2);\r\n            poke(smoothedFeatures_old, loFreq, i*featureStride+2);\r\n            \r\n            // smooth and write E\r\n            energy_current = peek(smoothedFeatures_old, i*featureStride+0);\r\n            energy_smooth = lerp(energy_current, 0, 0.001);\r\n            poke(buf_smoothedFeatures, energy_smooth, timeIndex, i*featureStride+0);\r\n            poke(smoothedFeatures_old, energy_smooth, i*featureStride+0);\r\n            \r\n            // write in Wr (no smoothing)\r\n            poke(buf_smoothedFeatures, Wr_target, timeIndex, i*featureStride+1);\r\n            poke(smoothedFeatures_old, Wr_target, i*featureStride+1);\r\n            \r\n            // write all the other values\r\n            // j starts at 3 cause we're skipping E, W0 and Wr (handled above)\r\n            for (j = 3; j<featureStride; j+=1) \r\n            {\r\n                // read, smooth, write\r\n                val  = peek(smoothedFeatures_old, i*featureStride+j);\r\n                val_smooth = lerp(val, 0, 0.001);\r\n                poke(buf_smoothedFeatures, val_smooth, timeIndex, i*featureStride+j);\r\n                poke(smoothedFeatures_old, val_smooth, i*featureStride+j);\r\n            }            \r\n        }   \r\n    }\r\n}",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox",
