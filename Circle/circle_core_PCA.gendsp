            {
                "box": {
                    "code": "thisChanFreq_Hz = in1 * pow(in2, in3);\r\nthisChanPeriod_sec = 1.0 / thisChanFreq_Hz;\r\nthisChanPeriod_samps = thisChanPeriod_sec * samplerate;\r\n\r\n// the oldestIndex (index of oldest sample in our rolling buffer)\r\n// is the currentIndex minus the period of interest, modulo the buffer length\r\n// here we first add the buffer length (in5) so that we dont have\r\n// to deal with negative modulo b.s.\r\nout1 = (in4 + in5 - thisChanPeriod_samps) % in5;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-115",
                    "maxclass": "codebox",
                    "numinlets": 5,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 361.0, 288.17205572128296, 620.4301348924637, 178.49463152885437 ]
                }
